# LaTeX build output. main.pdf was tracked until 2026-09-05 and was removed
# from history at Sam's request -- the manuscript is moving to Overleaf, which
# builds its own PDF, so a committed one only ever goes stale and conflicts.
# Rebuild locally with the commands in README.md.
main.pdf
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# Agent working instructions, untracked 2026-09-06. Local tooling rather than
# something to publish. NAR_REQUIREMENTS.md remains the tracked authority on
# the actual journal rules, so nothing a contributor needs is lost with it.
CLAUDE.md
supplementary.pdf

# preprint.pdf is the bioRxiv concatenation of the two PDFs above, so it is
# build output for the same reason they are. preprint.tex is tracked.
preprint.pdf

# Referee-facing tracked-changes copies (make_marked_copy.sh output). These
# are for reviewers during the submission/revision process and are not part
# of the public manuscript -- untracked 2026-10-05. Regenerate locally with
# ./make_marked_copy.sh as needed; see README.md.
main_diff.tex
main_diff.pdf
supplementary_diff.tex
supplementary_diff.pdf

# Dead leftover from the old \rev{} redline-toggle mechanism (superseded by
# make_marked_copy.sh / latexdiff). Nothing references main_clean.tex
# anymore -- removed from tracking 2026-10-05.
main_clean.tex

# NAR_Revised_Manuscript_{Clean,Marked}.pdf are build verification only --
# NAR's revision format is .tex/.docx/.rtf, explicitly NOT PDF, so the .tex
# files are the tracked deliverable; the PDFs are gitignored like main.pdf
# above. Regenerate with pdflatex (no bibtex needed -- both carry an
# inlined \begin{thebibliography} block, not \bibliography{references}).
NAR_Revised_Manuscript_Clean.pdf
NAR_Revised_Manuscript_Marked.pdf
