<?xml version="1.0" encoding="UTF-8" ?>
<!-- Schema for ModelSEED Biochemistry: Compounds
     Solr 9.x, ClassicIndexSchemaFactory, nested-document enabled.

     Parent doc = one compound. Nested child docs carry per-source
     thermodynamics and per-source pKa/pKb data so that the UI can render
     everything a compound page needs from a single `q=id:cpdXXXXX&fl=*,[child]`
     request, and search can filter parent compounds by child-level
     conditions (e.g. "compounds with an eQuilibrator ΔfG between X and Y").

     Nested layout:
       compound (parent, doc_type=compound)
         └─ thermodynamics/ (nest_path=/thermodynamics, doc_type=thermodynamics)
              fields: source_name, energy, error
         └─ pkas/           (nest_path=/pkas,           doc_type=pkas)
              fields: source_name, pka_kind,
                      pka_value, pka_number, pkb_value, pkb_number

     pKa children are per SOURCE, not per site: Marvin, MolGpKa and Literature
     each contribute one child. *_value keeps the stored "<fragment>:<value>"
     encoding; *_number is the same ladder as bare floats so it is
     range-queryable. pka_kind distinguishes microscopic (per-site values on
     one protonation state) from macroscopic (sequential dissociations) —
     reading the first as the second is a category error, so filter on it.
-->

<schema name="compounds" version="1.6">
	<fields>

		<!-- ============================================================
		     Nested-document plumbing (Solr 9). _root_, _nest_path_, and
		     _nest_parent_ are auto-populated when a nested add is used.
		     doc_type is our own explicit discriminator for readable
		     queries alongside the auto-populated _nest_path_.
		     ============================================================ -->
		<field name="_root_"        type="string"  indexed="true"  stored="false" docValues="false"/>
		<field name="_nest_path_"   type="string"  indexed="true"  stored="true"/>
		<field name="_nest_parent_" type="string"  indexed="true"  stored="true"/>
		<field name="doc_type"      type="string"  indexed="true"  stored="true"/>

		<!-- ============================================================
		     Parent compound fields
		     ============================================================ -->
		<field name="id"                type="string"     indexed="true"  stored="true"  required="true"/>
		<field name="abbreviation"      type="string_ci"  indexed="true"  stored="true"  docValues="true"/>
		<field name="name"              type="string_ci"  indexed="true"  stored="true"  docValues="true"/>
		<field name="formula"           type="string"     indexed="true"  stored="true"  docValues="true"/>
		<field name="mass"              type="float"      indexed="true"  stored="true"/>
		<field name="charge"            type="float"      indexed="true"  stored="true"/>
		<field name="source"            type="string"     indexed="true"  stored="true"/>

		<field name="smiles"            type="string"     indexed="true"  stored="true"/>
		<field name="inchikey"          type="string"     indexed="true"  stored="true"/>

		<field name="is_core"           type="boolean"    indexed="true"  stored="true"/>
		<field name="is_obsolete"       type="boolean"    indexed="true"  stored="true"/>
		<field name="is_cofactor"       type="boolean"    indexed="true"  stored="true"/>

		<field name="class"             type="string_ci"  indexed="true"  stored="true"  docValues="true"/>

		<field name="linked_compound"   type="string"     indexed="true"  stored="true"/>
		<field name="abstract_compound" type="string"     indexed="true"  stored="true"/>
		<field name="comprised_of"      type="string"     indexed="true"  stored="true"/>

		<field name="aliases"           type="string_ci"  indexed="true"  stored="true"  docValues="true"  multiValued="true"/>
		<field name="notes"             type="string"     indexed="true"  stored="true"                     multiValued="true"/>

		<!-- Backwards-compatible top-level scalars from the pre-2026 schema.
		     Same value as the promoted per-source pick. Deprecated; kept so
		     legacy consumers don't break at cutover. -->

		<!-- ============================================================
		     Denormalized flat fields — derived from the JSON at compile
		     time and stored on the parent for fast filtering / faceting
		     without needing a block-join query.
		     ============================================================ -->
		<!-- true when smiles is non-empty. Fast filter for "compounds we
		     can atom-map / structure-search". -->
		<field name="has_structure"           type="boolean"  indexed="true"  stored="true"/>
		<!-- Per-element atom counts parsed from `formula`. Enable range
		     queries like "atom_count_C:[3 TO 6]" for central-metabolism-
		     scale browsing. -->
		<field name="atom_count_C"            type="int"      indexed="true"  stored="true"/>
		<field name="atom_count_N"            type="int"      indexed="true"  stored="true"/>
		<field name="atom_count_O"            type="int"      indexed="true"  stored="true"/>
		<field name="atom_count_P"            type="int"      indexed="true"  stored="true"/>
		<field name="atom_count_S"            type="int"      indexed="true"  stored="true"/>
		<!-- Convenience count: how many sources gave a numeric ΔfG. Same as
		     len(thermodynamics{}) at compile time. -->
		<field name="n_sources_thermodynamics" type="int"     indexed="true"  stored="true"/>
		<!-- True when the compound sits in the canonical Convention A
		     electron-carrier anchor table (ferredoxin / thioredoxin /
		     flavodoxin / glutaredoxin pairs after that PR lands). -->
		<field name="is_electron_carrier"     type="boolean"  indexed="true"  stored="true"/>

		<!-- Compile-time provenance -->
		<field name="date_inserted"     type="tdate"      indexed="true"  stored="true"  default="NOW"/>
		<field name="date_modified"     type="tdate"      indexed="true"  stored="true"  default="NOW"/>
		<field name="_version_"         type="long"       indexed="true"  stored="true"/>

		<!-- Aggregated free-text field for the main search box. See
		     copyField declarations below. -->
		<field name="text"              type="text_custom"  indexed="true"  stored="false"  multiValued="true"/>

		<!-- ============================================================
		     Child-document fields (thermodynamics, pkas)

		     Child docs share the fields namespace with parents in classic
		     schema; they're distinguished by `doc_type` and `_nest_path_`.
		     ============================================================ -->
		<!-- Common child fields (used by both thermodynamics and pkas
		     children; both carry a `source` string). -->
		<field name="source_name"       type="string_ci"  indexed="true"  stored="true"  docValues="true"/>

		<!-- Thermodynamics child fields -->
		<field name="energy"            type="float"      indexed="true"  stored="true"/>
		<field name="error"             type="float"      indexed="true"  stored="true"/>

		<!-- pKas child fields. Stored as the historical string format
		     "1:14:12.60;1:22:3.33;..." (fragment:atom:value). Not further
		     parsed here to preserve exact reproducibility with the JSON. -->
		<field name="pka_value"         type="string"     indexed="true"  stored="true"  multiValued="true"/>
		<field name="pkb_value"         type="string"     indexed="true"  stored="true"  multiValued="true"/>
		<!-- microscopic | macroscopic. Per-site values on one protonation
		     state versus sequential dissociations of the whole molecule.
		     Treating the first as the second is a category error, so a
		     consumer must be able to filter on it. -->
		<field name="pka_kind"          type="string"     indexed="true"  stored="true"/>
		<!-- The bare floats parsed out of *_value, order preserved, so the
		     ladder is range-queryable without the caller parsing the
		     "<fragment>:<value>" encoding. One compound's ladder arrives as
		     a single semicolon-joined string, hence multiValued. -->
		<field name="pka_number"        type="float"      indexed="true"  stored="true"  multiValued="true"/>
		<field name="pkb_number"        type="float"      indexed="true"  stored="true"  multiValued="true"/>
	</fields>

	<uniqueKey>id</uniqueKey>

	<!-- Free-text search across identity, name, formula, alias, note fields.
	     `text` is not stored; only used for scoring. -->
	<copyField source="id"           dest="text"/>
	<copyField source="abbreviation" dest="text"/>
	<copyField source="name"         dest="text"/>
	<copyField source="formula"      dest="text"/>
	<copyField source="aliases"      dest="text"/>
	<copyField source="notes"        dest="text"/>

	<xi:include href="schema_types.xml" xmlns:xi="http://www.w3.org/2001/XInclude">
		<xi:fallback></xi:fallback>
	</xi:include>
</schema>
